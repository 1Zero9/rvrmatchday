# Environment Variables for RVR Match Day
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret for Match Recorder Authentication
# Generate a secure random string for production
JWT_SECRET=your_super_secure_jwt_secret_here_min_32_characters

# Admin Panel Credentials (Change these immediately!)
NEXT_PUBLIC_ADMIN_USER=your_admin_username
NEXT_PUBLIC_ADMIN_PASS=your_secure_admin_password
NEXT_PUBLIC_MATCH_CENTRAL_PASS=your_secure_match_central_password

# Demo User Passwords (for development/testing only)
DEMO_ADMIN_PASS=your_demo_admin_password
DEMO_COACH_PASS=your_demo_coach_password
DEMO_MANAGER_PASS=your_demo_manager_password
DEMO_PARENT_PASS=your_demo_parent_password

# Email Configuration for User Management
ADMIN_EMAIL=admin@yourclub.com
# SMTP Configuration (Gmail example)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourclub.com
# SendGrid Alternative
# SENDGRID_API_KEY=your-sendgrid-api-key

# Security Settings
# NODE_ENV=production
# NEXTAUTH_URL=https://yourdomain.com
# NEXTAUTH_SECRET=your_nextauth_secret_here