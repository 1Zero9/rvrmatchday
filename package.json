{
  "name": "clean-app",
  "version": "6.0.14",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:robust": "./dev-server.sh",
    "dev:simple": "next dev --turbopack --port 3000",
    "dev:clean": "pkill -f 'next dev' || true && lsof -ti:3000 | xargs kill -9 2>/dev/null || true && sleep 2 && npm run dev",
    "health": "./health-check.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "framer-motion": "^12.23.12",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "next": "15.4.6",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  }
}
