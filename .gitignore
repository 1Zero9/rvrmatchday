# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# old/broken backups
src_old/
src_broken/


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit these - contain sensitive keys)
.env*
!.env.example
!.env.local.example

# Database and sensitive files
*-old.*
*backup*
*secret*
*password*
*credential*
admin-setup.*

# Database files (allow setup/migration scripts but ignore temp/private ones)
database/temp/
database/private/
database/dumps/
*.sql.bak
*_backup.sql
local_*.sql

# vercel
.vercel

# Sales and marketing materials (confidential/local only)
*sales*
*marketing*
*pricing*
*SALES*
*MARKETING*
*PRICING*
PRODUCT_SALES*.md
MARKETING_PACKAGE.md
TECHNICAL_COMPONENT_BREAKDOWN.md

# typescript
*.tsbuildinfo
next-env.d.ts
DEVELOPMENT_REPORT_48H.md
MATCH_CENTRAL_ENHANCEMENT_PLAN.md
